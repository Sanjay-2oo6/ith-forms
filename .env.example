# Supabase project configuration (both are inlined at build time).
# The anon key is public by design — Row-Level Security governs all access.
# NEVER put the service-role key in this project — it's only for local scripts.

# Get these from Supabase Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay Configuration (for native payment integration)
# Get your key_id from Razorpay Dashboard > Settings > API Keys
# This is the PUBLIC key (key_id), NOT the secret key
# Starts with rzp_test_ (test mode) or rzp_live_ (production)
# 
# ⚠️ IMPORTANT: The secret key (RAZORPAY_KEY_SECRET) must be stored in Supabase vault:
#   1. Go to Supabase Dashboard > Project Settings > Vault
#   2. Add secrets: RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET
#   3. The backend RPCs will retrieve them from vault for API calls and signature verification
# NEVER expose RAZORPAY_KEY_SECRET in environment variables or client-side code.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ⚠️ IMPORTANT FOR VERCEL DEPLOYMENT:
# These env vars MUST be set in Vercel Dashboard Settings → Environment Variables (Production)
# before deployment. They will be baked into the build at compile time.
# If missing, the app will fail to connect to Supabase.

# ⚠️ Only for local use (scripts/create-test-admin.mjs)
# NEVER commit this to git or expose in Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Error tracking & monitoring (optional but recommended for production)
# Create free account at https://sentry.io and generate a DSN
# Frontend error tracking (available in browser, inlined at build)
VITE_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Server-side error tracking (runtime only, not inlined in browser)
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
