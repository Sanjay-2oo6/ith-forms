# Supabase project configuration (both are inlined at build time).
# The anon key is public by design — Row-Level Security governs all access.
# NEVER put the service-role key in this project — it's only for local scripts.

# Get these from Supabase Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ⚠️ Only for local use (scripts/create-test-admin.mjs)
# NEVER commit this to git or expose in Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
